[node name="Layout" type="VBoxContainer" parent="Scrim/Centre/Panel"]
layout_mode = 2
theme_override_constants/separation = 16

; Title on the left, both purses on the right. The two numbers a trade depends
; on are the ones a player checks first, so they sit in the header rather than
; at the bottom where the old layout put them.
