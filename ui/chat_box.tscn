[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/chat_box.gd" id="1_chat"]

[node name="ChatBox" type="CanvasLayer" node_paths=PackedStringArray("log_label", "entry", "scroll")]
layer = 2
script = ExtResource("1_chat")
log_label = NodePath("Anchor/Panel/Rows/Scroll/Log")
entry = NodePath("Anchor/Panel/Rows/Entry")
scroll = NodePath("Anchor/Panel/Rows/Scroll")

; Bottom left, above the health bars and clear of the pickup prompt.
[node name="Anchor" type="MarginContainer" parent="."]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_top = -370.0
offset_right = 480.0
offset_bottom = -110.0
grow_vertical = 0
theme_override_constants/margin_left = 16
theme_override_constants/margin_bottom = 8

[node name="Panel" type="PanelContainer" parent="Anchor"]
layout_mode = 2
theme_type_variation = &"Sunken"

[node name="Rows" type="VBoxContainer" parent="Anchor/Panel"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Anchor/Panel/Rows"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Log" type="RichTextLabel" parent="Anchor/Panel/Rows/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
bbcode_enabled = false
fit_content = true
scroll_active = false

[node name="Entry" type="LineEdit" parent="Anchor/Panel/Rows"]
layout_mode = 2
placeholder_text = "Say something, then Enter"
max_length = 240
