[gd_resource type="AudioBusLayout" format=3]

; Music has its own bus so it can be turned down without turning the game down.
; Godot loads this automatically: `audio/buses/default_bus_layout` already
; points here, so the file existing is the whole wiring.
[resource]
bus/1/name = &"Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
