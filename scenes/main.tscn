[ext_resource type="Script" path="res://scripts/chat/chat_service.gd" id="29_chat_service"]
[ext_resource type="PackedScene" path="res://ui/chat_box.tscn" id="30_chat_box"]
[ext_resource type="PackedScene" path="res://ui/store_screen.tscn" id="31_store"]
[ext_resource type="Script" path="res://scripts/world/merchant_post.gd" id="32_post"]
[ext_resource type="PackedScene" path="res://characters/merchant.tscn" id="33_merchant"]

; local_to_scene on all three, and it is load-bearing. Sub-resources are
; SHARED between instantiations of a scene by default, so without it two
; worlds -- two tests, or a second window later -- write the same uniforms and
; one world's clock recolours the other's sky.
[sub_resource type="ShaderMaterial" id="ShaderMaterial_sky"]
resource_local_to_scene = true
shader = ExtResource("19_sky_shader")

; Incremental, over a small cubemap. The sky lights the world through this, so
; it has to keep up with the sun -- but a full re-bake every frame for a light
; that moves a degree a second is paying for nothing.
[sub_resource type="Sky" id="Sky_o5qli"]
resource_local_to_scene = true
sky_material = SubResource("ShaderMaterial_sky")
radiance_size = 2
process_mode = 2

[sub_resource type="NavigationMesh" id="NavigationMesh_world"]
geometry_parsed_geometry_type = 2
geometry_source_geometry_mode = 2
geometry_source_group_name = &"navigation_source"
; Matches the navigation map's own defaults. A mismatch warns on every
; region added and quietly degrades the bake.
cell_size = 0.2
cell_height = 0.2
agent_height = 1.8
; Exactly two cells at 0.2, which is the whole point. The bake ceils the radius
; to whole voxels, so what matters is not that the cells are small but that the
; radius is a multiple of them: 0.55 at 0.25 became 0.75 and left a 1.6 m
; doorway with a tenth of a metre of navigable width. 0.4 at 0.2 is 0.4
; exactly, and costs a sixteenth of the bake that 0.1 did over a 256 m tile.
agent_radius = 0.4
; Two cells exactly. Floored to cell_height, so 0.3 at 0.2 became 0.2 and
; warned about it.
agent_max_climb = 0.4
agent_max_slope = 45.0
; Converted to int, so 0.5 became 0. Whole numbers only.
region_min_size = 2.0
filter_low_hanging_obstacles = true
filter_ledge_spans = true
filter_walkable_low_height_spans = true

[sub_resource type="Environment" id="Environment_0wfyh"]
resource_local_to_scene = true
background_mode = 2
sky = SubResource("Sky_o5qli")
ambient_light_source = 3
tonemap_mode = 2

[node name="Main" type="Node3D" unique_id=159748148 node_paths=PackedStringArray("terrain", "player", "player_movement", "player_attack", "player_collector", "player_router", "player_dropper", "player_interactor", "camera", "companion", "companion_follow", "workbench")]
script = ExtResource("3_root")
terrain = NodePath("Terrain")
player = NodePath("Player")
player_movement = NodePath("Player/Movement")
player_attack = NodePath("Player/Attack")
player_collector = NodePath("Player/Collector")
player_router = NodePath("Player/Router")
player_dropper = NodePath("Player/Dropper")
player_interactor = NodePath("Player/Interactor")
camera = NodePath("PlayerCamera")
spawn_point = Vector2(-3, 0)
companion = NodePath("Companion")
companion_spawn = Vector2(-4.5, 1.5)
companion_follow = NodePath("Companion/Follow")
workbench = NodePath("Workbench")
workbench_spawn = Vector2(3.4, -3.4)

; Single-player is a host with one local player and no socket, not a separate
; mode. See MULTIPLAYER.md.
[node name="Session" type="Node" parent="."]
script = ExtResource("16_session")
mode = 0

[node name="Network" type="Node" parent="." node_paths=PackedStringArray("session")]
script = ExtResource("17_network")
session = NodePath("../Session")

[node name="Replication" type="Node" parent="." node_paths=PackedStringArray("session", "network", "spawn_root", "terrain")]
script = ExtResource("18_replication")
session = NodePath("../Session")
network = NodePath("../Network")
spawn_root = NodePath("../Wanderers")
terrain = NodePath("../Terrain")
player_scene = ExtResource("4_player")
wanderer_scene = ExtResource("13_wanderer")
companion_scene = ExtResource("15_companion")
spawn_point = Vector2(-3, 0)

[node name="WorldEnvironment" type="WorldEnvironment" parent="." unique_id=159123357]
environment = SubResource("Environment_0wfyh")

[node name="Sun" type="DirectionalLight3D" parent="." unique_id=1393550790]
transform = Transform3D(0.59999996, -0.7155418, 0.3577709, 0, 0.4472136, 0.8944272, -0.8, -0.53665626, 0.26832816, 0, 10, 0)
shadow_enabled = true

[node name="DayNight" type="Node" parent="." node_paths=PackedStringArray("sun")]
script = ExtResource("5_day_night")
config = ExtResource("6_day_night_config")
sun = NodePath("../Sun")

[node name="Sky" type="Node" parent="." node_paths=PackedStringArray("day_night", "environment")]
script = ExtResource("21_sky")
config = ExtResource("20_sky_config")
day_night = NodePath("../DayNight")
environment = NodePath("../WorldEnvironment")

[node name="Terrain" parent="." instance=ExtResource("1_terrain")]

[node name="Navigation" type="NavigationRegion3D" parent="."]
navigation_mesh = SubResource("NavigationMesh_world")

[node name="Level" type="Node3D" parent="." node_paths=PackedStringArray("terrain", "navigation_region")]
script = ExtResource("8_level")
terrain = NodePath("../Terrain")
structure_config = ExtResource("9_structure_config")
navigation_region = NodePath("../Navigation")

[node name="Wanderers" type="Node3D" parent="." node_paths=PackedStringArray("terrain", "keep_away_from")]
script = ExtResource("12_spawner")
scene = ExtResource("13_wanderer")
terrain = NodePath("../Terrain")
count = 6
respawn = true
respawn_delay = 8.0
keep_away = 14.0
keep_away_from = NodePath("../Player")

; Position comes from WorldRoot, which drops it onto the floor. Only the
; rotation is authored here.
[node name="Workbench" parent="." instance=ExtResource("26_workbench")]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 0, 0, 0)

; One outside the base door and one out in the field, both facing back toward
; where the player comes from.
[node name="Merchants" type="Node3D" parent="." node_paths=PackedStringArray("terrain")]
script = ExtResource("32_post")
scene = ExtResource("33_merchant")
terrain = NodePath("../Terrain")
positions = Array[Vector2]([Vector2(8, 6), Vector2(-14, 18)])
facings = Array[float]([200.0, 20.0])
starting_gold = 400
starting_items = Dictionary[String, int]({
"res://resources/items/sword.tres": 2
})

[node name="Chat" type="Node" parent="." node_paths=PackedStringArray("session", "network")]
script = ExtResource("29_chat_service")
session = NodePath("../Session")
network = NodePath("../Network")
player_name = "You"
history = 100

[node name="Music" type="Node" parent="."]
script = ExtResource("27_music")
config = ExtResource("28_music_config")
autoplay = true
volume_db = -6.0

[node name="Mushrooms" type="Node3D" parent="." node_paths=PackedStringArray("terrain")]
script = ExtResource("22_patch")
scene = ExtResource("23_mushroom")
terrain = NodePath("../Terrain")
count = 14
regrow = true
regrow_seconds = 20.0

[node name="Player" parent="." instance=ExtResource("4_player")]

