[gd_scene format=3]

[ext_resource type="PackedScene" path="res://world/terrain.tscn" id="1_terrain"]
[ext_resource type="PackedScene" path="res://prefabs/third_person_camera.tscn" id="2_camera"]
[ext_resource type="Script" path="res://scripts/world/world_root.gd" id="3_root"]
[ext_resource type="PackedScene" path="res://characters/player.tscn" id="4_player"]
[ext_resource type="Script" path="res://scripts/systems/day_night_component.gd" id="5_day_night"]
[ext_resource type="Resource" path="res://resources/day_night/default_day_night.tres" id="6_day_night_config"]
[ext_resource type="PackedScene" path="res://ui/debug_overlay.tscn" id="7_overlay"]
[ext_resource type="Script" path="res://scripts/world/prototype_level.gd" id="8_level"]
[ext_resource type="Resource" path="res://resources/structures/prototype_structure.tres" id="9_structure_config"]
[ext_resource type="PackedScene" path="res://ui/dev_console.tscn" id="10_console"]
[ext_resource type="PackedScene" path="res://ui/pause_menu.tscn" id="11_pause"]
[ext_resource type="Script" path="res://scripts/world/wanderer_spawner.gd" id="12_spawner"]
[ext_resource type="PackedScene" path="res://characters/wanderer.tscn" id="13_wanderer"]
[ext_resource type="PackedScene" path="res://ui/player_hud.tscn" id="14_hud"]
[ext_resource type="PackedScene" path="res://characters/companion.tscn" id="15_companion"]
[ext_resource type="Script" path="res://scripts/systems/game_session.gd" id="16_session"]
[ext_resource type="Script" path="res://scripts/systems/network_service.gd" id="17_network"]

[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_sgp6g"]

[sub_resource type="Sky" id="Sky_o5qli"]
sky_material = SubResource("ProceduralSkyMaterial_sgp6g")

[sub_resource type="NavigationMesh" id="NavigationMesh_world"]
geometry_parsed_geometry_type = 2
geometry_source_geometry_mode = 2
geometry_source_group_name = &"navigation_source"
; Matches the navigation map's own defaults. A mismatch warns on every
; region added and quietly degrades the bake.
cell_size = 0.1
cell_height = 0.1
agent_height = 1.8
; Exactly two cells. The bake ceils this to whole voxels, so 0.55 became 0.75
; -- which erodes 0.75 m from every wall and leaves a 1.6 m doorway with a
; tenth of a metre of navigable width. Companions then cannot path indoors at
; all, which looks exactly like pathfinding being broken.
agent_radius = 0.4
agent_max_climb = 0.3
agent_max_slope = 45.0
region_min_size = 0.5
filter_low_hanging_obstacles = true
filter_ledge_spans = true
filter_walkable_low_height_spans = true

[sub_resource type="Environment" id="Environment_0wfyh"]
background_mode = 2
sky = SubResource("Sky_o5qli")
ambient_light_source = 3
tonemap_mode = 2

[node name="Main" type="Node3D" unique_id=159748148 node_paths=PackedStringArray("terrain", "player", "player_movement", "player_attack", "camera", "companion", "companion_follow")]
script = ExtResource("3_root")
terrain = NodePath("Terrain")
player = NodePath("Player")
player_movement = NodePath("Player/Movement")
player_attack = NodePath("Player/Attack")
camera = NodePath("PlayerCamera")
spawn_point = Vector2(-3, 0)
companion = NodePath("Companion")
companion_spawn = Vector2(-4.5, 1.5)
companion_follow = NodePath("Companion/Follow")

; Single-player is a host with one local player and no socket, not a separate
; mode. See MULTIPLAYER.md.
[node name="Session" type="Node" parent="."]
script = ExtResource("16_session")
mode = 0

[node name="Network" type="Node" parent="." node_paths=PackedStringArray("session")]
script = ExtResource("17_network")
session = NodePath("../Session")

[node name="WorldEnvironment" type="WorldEnvironment" parent="." unique_id=159123357]
environment = SubResource("Environment_0wfyh")

[node name="Sun" type="DirectionalLight3D" parent="." unique_id=1393550790]
transform = Transform3D(0.59999996, -0.7155418, 0.3577709, 0, 0.4472136, 0.8944272, -0.8, -0.53665626, 0.26832816, 0, 10, 0)
shadow_enabled = true

[node name="DayNight" type="Node" parent="." node_paths=PackedStringArray("sun")]
script = ExtResource("5_day_night")
config = ExtResource("6_day_night_config")
sun = NodePath("../Sun")

[node name="Terrain" parent="." instance=ExtResource("1_terrain")]

[node name="Navigation" type="NavigationRegion3D" parent="."]
navigation_mesh = SubResource("NavigationMesh_world")

[node name="Level" type="Node3D" parent="." node_paths=PackedStringArray("terrain", "navigation_region")]
script = ExtResource("8_level")
terrain = NodePath("../Terrain")
structure_config = ExtResource("9_structure_config")
navigation_region = NodePath("../Navigation")

[node name="Wanderers" type="Node3D" parent="." node_paths=PackedStringArray("terrain", "keep_away_from")]
script = ExtResource("12_spawner")
scene = ExtResource("13_wanderer")
terrain = NodePath("../Terrain")
count = 6
respawn = true
respawn_delay = 8.0
keep_away = 14.0
keep_away_from = NodePath("../Player")

[node name="Player" parent="." instance=ExtResource("4_player")]

[node name="Companion" parent="." instance=ExtResource("15_companion")]

[node name="PlayerCamera" parent="." instance=ExtResource("2_camera")]

[node name="PlayerHud" parent="." instance=ExtResource("14_hud") node_paths=PackedStringArray("health", "stamina")]
health = NodePath("../Player/Health")
stamina = NodePath("../Player/Stamina")

[node name="DebugOverlay" parent="." instance=ExtResource("7_overlay") node_paths=PackedStringArray("body", "movement", "health", "stamina", "animation", "day_night")]
body = NodePath("../Player")
movement = NodePath("../Player/Movement")
health = NodePath("../Player/Health")
stamina = NodePath("../Player/Stamina")
animation = NodePath("../Player/Animation")
day_night = NodePath("../DayNight")

[node name="DevConsole" parent="." instance=ExtResource("10_console") node_paths=PackedStringArray("world_root", "player", "health", "stamina", "movement", "day_night", "terrain", "network", "session")]
world_root = NodePath("..")
player = NodePath("../Player")
health = NodePath("../Player/Health")
stamina = NodePath("../Player/Stamina")
movement = NodePath("../Player/Movement")
day_night = NodePath("../DayNight")
terrain = NodePath("../Terrain")
network = NodePath("../Network")
session = NodePath("../Session")

[node name="PauseMenu" parent="." instance=ExtResource("11_pause") node_paths=PackedStringArray("world_root", "camera")]
world_root = NodePath("..")
camera = NodePath("../PlayerCamera")
