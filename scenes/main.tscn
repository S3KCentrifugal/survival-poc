[ext_resource type="Script" path="res://scripts/systems/replication_service.gd" id="18_replication"]
[ext_resource type="Shader" path="res://shaders/sky.gdshader" id="19_sky_shader"]
[ext_resource type="Resource" path="res://resources/sky/default_sky.tres" id="20_sky_config"]
[ext_resource type="Script" path="res://scripts/systems/sky_component.gd" id="21_sky"]
[ext_resource type="Script" path="res://scripts/world/mushroom_patch.gd" id="22_patch"]
[ext_resource type="PackedScene" path="res://items/mushroom.tscn" id="23_mushroom"]
[ext_resource type="PackedScene" path="res://ui/inventory_screen.tscn" id="24_inventory_screen"]
[ext_resource type="PackedScene" path="res://ui/crafting_screen.tscn" id="25_crafting_screen"]
[ext_resource type="PackedScene" path="res://world/workbench.tscn" id="26_workbench"]
[ext_resource type="Script" path="res://scripts/audio/music_player.gd" id="27_music"]
