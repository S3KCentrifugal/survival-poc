[navigation]

; The agent radius (0.4) must be an exact multiple of this, or the bake ceils it
; up and erodes more than asked from every surface -- 0.55 at 0.25 became 0.75
; and closed a 1.6 m doorway entirely. 0.2 divides 0.4 exactly. Finer than that
; is not more correct, only slower: 0.1 over a 256 m tile is 6.5 million voxels
; and six seconds. Must match the navmesh's own cell size or every region warns.
3d/default_cell_size=0.2
3d/default_cell_height=0.2

[rendering]

textures/vram_compression/import_etc2_astc=true
