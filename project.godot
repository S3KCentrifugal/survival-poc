[navigation]

; Finer than the 0.25 default. A doorway is 1.6 m wide in a 0.3 m wall, and the
; bake erodes the agent radius from every surface -- at 0.25 the remaining gap
; does not survive rasterisation and the inside of a building becomes an island
; nothing can path out of. Must match the navmesh's own cell size or every
; region added warns.
3d/default_cell_size=0.1
3d/default_cell_height=0.1

[rendering]

textures/vram_compression/import_etc2_astc=true
