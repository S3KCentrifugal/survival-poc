[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_body"]
radius = 0.4
height = 1.8

[node name="Player" type="CharacterBody3D"]
floor_snap_length = 0.5

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("CapsuleShape3D_body")

; Turned to face the body's -Z. The mesh is authored facing +Z, which a
; top-down camera could not show -- see devblog 016.
[node name="Model" parent="." instance=ExtResource("3_model")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)


; Draws the imported model through the shared stylised shader, in the character
; value band. Rule 3: the gap between this band and the ground's is what makes a
; silhouette read, and it is the only thing that does -- there are no outlines.
; The player alone is re-proportioned and re-skinned into a person. Everything
; else in the world keeps the robot, which is the point: the thing you control
; should not look like the things you meet.
; The hand the sword goes in. A BoneAttachment3D follows the bone, so the
; existing Attack1 clip swings the weapon without a frame of new animation.
[node name="Grip" type="BoneAttachment3D" parent="Model/RobotArmature/Skeleton3D"]
bone_name = "hand.R"
bone_idx = 16

[node name="Humanoid" type="Node" parent="Model" node_paths=PackedStringArray("model")]
script = ExtResource("95_humanoid")
model = NodePath("..")

[node name="Surface" type="Node" parent="Model" node_paths=PackedStringArray("model")]
script = ExtResource("91_stylised")
model = NodePath("..")
band = 3

; Carry a sword and you are holding it. There is no equip screen because there
; is one weapon, and a screen for it would be a screen with one button.
[node name="Weapon" type="Node" parent="." node_paths=PackedStringArray("grip", "inventory", "attack")]
script = ExtResource("96_weapon")
grip = NodePath("../Model/RobotArmature/Skeleton3D/Grip")
inventory = NodePath("../Inventory")
attack = NodePath("../Attack")
weapons = Array[Resource]([ExtResource("97_sword")])

