[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_body"]
radius = 0.4
height = 1.8

[node name="Wanderer" type="CharacterBody3D"]
floor_snap_length = 0.5

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("CapsuleShape3D_body")

; Turned to face the body's -Z, same as the player: the mesh is authored
; facing +Z. See devblog 016.
[node name="Model" parent="." instance=ExtResource("3_model")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)


; Draws the imported model through the shared stylised shader, in the character
; value band. Rule 3: the gap between this band and the ground's is what makes a
; silhouette read, and it is the only thing that does -- there are no outlines.
[node name="Surface" type="Node" parent="Model" node_paths=PackedStringArray("model")]
script = ExtResource("93_stylised")
model = NodePath("..")
band = 3

